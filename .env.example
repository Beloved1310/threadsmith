# Copy to threadsmith/backend/thread_smith/.env and fill in. Never put real keys in this file.
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

# Per-agent models (pinned; -latest aliases have gone 404 overnight before).
RESEARCH_MODEL=gemini-2.5-flash
WRITER_MODEL=gemini-2.5-flash
ORCHESTRATOR_MODEL=gemini-2.5-flash

# --- Publishing via Buffer (X must be connected as a channel in Buffer) ---
# DRY_RUN=true (default): publish_thread shows the exact payload and sends
# NOTHING. Set to false only when you mean to queue a real thread.
DRY_RUN=true
BUFFER_API_KEY=
# Live sends are scheduled at least this many minutes ahead so you can delete
# them in Buffer before they go out. 0 = add to Buffer's normal queue.
BUFFER_REVIEW_DELAY_MINUTES=60
